rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each account may read and write only its own progress document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections, if added later, follow the same ownership rule.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
